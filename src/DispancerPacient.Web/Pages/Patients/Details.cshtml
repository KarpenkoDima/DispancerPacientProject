@page "{id:int}"
@model DispancerPacient.Web.Pages.Patients.DetailsModel
@{
    ViewData["Title"] = $"Пациент: {Model.Patient.FullName}";
}

<h1>@Model.Patient.FullName</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header"><strong>Персональные данные</strong></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Дата рождения</dt>
                    <dd class="col-sm-7">@Model.Patient.BirthDate.ToString("dd.MM.yyyy")</dd>

                    <dt class="col-sm-5">Пол</dt>
                    <dd class="col-sm-7">@(Model.Patient.Gender == DispancerPacient.Domain.Enums.Gender.Male ? "Мужской" : "Женский")</dd>

                    <dt class="col-sm-5">ИНН (ИПН)</dt>
                    <dd class="col-sm-7">@(Model.Patient.IpnCode ?? "—")</dd>

                    <dt class="col-sm-5">Адрес</dt>
                    <dd class="col-sm-7">@(Model.Patient.Address ?? "—")</dd>

                    <dt class="col-sm-5">Телефон</dt>
                    <dd class="col-sm-7">@(Model.Patient.Phone ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header"><strong>Медицинские данные</strong></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Номер карты</dt>
                    <dd class="col-sm-7">@(Model.Patient.MedicalRecordNumber ?? "—")</dd>

                    <dt class="col-sm-5">Диагноз (МКХ-10)</dt>
                    <dd class="col-sm-7">@(Model.Patient.DiagnosisCode ?? "—")</dd>

                    <dt class="col-sm-5">Описание диагноза</dt>
                    <dd class="col-sm-7">@(Model.Patient.DiagnosisDescription ?? "—")</dd>

                    <dt class="col-sm-5">Лечащий врач</dt>
                    <dd class="col-sm-7">@(Model.Patient.DoctorName ?? "Не назначен")</dd>

                    <dt class="col-sm-5">На учёте</dt>
                    <dd class="col-sm-7">
                        @if (Model.Patient.IsOnRecord)
                        {
                            <span class="badge bg-success">Да</span>
                            @if (Model.Patient.RegistrationDate.HasValue)
                            {
                                <text> с @Model.Patient.RegistrationDate.Value.ToString("dd.MM.yyyy")</text>
                            }
                        }
                        else
                        {
                            <span class="badge bg-secondary">Снят с учёта</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Последние приёмы</strong>
        <a asp-page="/Appointments/Create" asp-route-patientId="@Model.Patient.Id" class="btn btn-sm btn-success">+ Новый приём</a>
    </div>
    <div class="card-body">
        @if (!Model.Patient.RecentAppointments.Any())
        {
            <p class="text-muted">Приёмов не зарегистрировано.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Дата</th>
                        <th>Тип</th>
                        <th>Врач</th>
                        <th>Диагноз</th>
                        <th>Статус</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var apt in Model.Patient.RecentAppointments)
                    {
                        <tr>
                            <td>@apt.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@apt.TypeName</td>
                            <td>@apt.DoctorName</td>
                            <td>@apt.DiagnosisCode</td>
                            <td><span class="badge bg-info">@apt.StatusName</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-page="Edit" asp-route-id="@Model.Patient.Id" class="btn btn-primary">Редактировать</a>
    <a asp-page="Index" class="btn btn-secondary ms-2">К списку</a>
</div>
