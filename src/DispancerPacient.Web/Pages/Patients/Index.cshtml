@page
@model DispancerPacient.Web.Pages.Patients.IndexModel
@{
    ViewData["Title"] = "Пациенты";
}

<h1>Пациенты диспансера</h1>

<div class="row mb-3">
    <div class="col-md-8">
        <form method="get" class="d-flex gap-2">
            <input type="text" asp-for="SearchTerm" class="form-control" placeholder="Поиск по ФИО, ИНН, номеру карты..." />
            <div class="form-check d-flex align-items-center ms-2">
                <input type="checkbox" asp-for="OnlyOnRecord" class="form-check-input" id="onlyOnRecord" />
                <label class="form-check-label ms-1" for="onlyOnRecord">Только на учёте</label>
            </div>
            <button type="submit" class="btn btn-primary">Найти</button>
        </form>
    </div>
    <div class="col-md-4 text-end">
        <a asp-page="Create" class="btn btn-success">+ Новый пациент</a>
    </div>
</div>

@if (!Model.Patients.Any())
{
    <div class="alert alert-info">Пациенты не найдены.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ФИО</th>
                <th>Дата рождения</th>
                <th>Номер карты</th>
                <th>Диагноз (МКХ-10)</th>
                <th>Лечащий врач</th>
                <th>На учёте</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var patient in Model.Patients)
            {
                <tr>
                    <td>
                        <a asp-page="Details" asp-route-id="@patient.Id">@patient.FullName</a>
                    </td>
                    <td>@patient.BirthDate.ToString("dd.MM.yyyy")</td>
                    <td>@patient.MedicalRecordNumber</td>
                    <td>@patient.DiagnosisCode</td>
                    <td>@patient.DoctorName</td>
                    <td>
                        @if (patient.IsOnRecord)
                        {
                            <span class="badge bg-success">Да</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Нет</span>
                        }
                    </td>
                    <td>
                        <a asp-page="Edit" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-primary">Ред.</a>
                        <a asp-page="Delete" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-danger">Удал.</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-muted">Всего: @Model.Patients.Count пациентов</p>
}
